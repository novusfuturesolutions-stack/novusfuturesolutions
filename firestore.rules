rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function admin() {
      return signedIn()
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
          || request.auth.token.email in ['admin@novusfuturesolutions.com', 'marcus.vance@novusfuturesolutions.com']
        );
    }

    function validPublicRole(role) {
      return role in ['professional', 'company', 'provider', 'customer', 'admin'];
    }

    // User accounts: candidates manage their own profiles; administrators manage all accounts.
    match /users/{userId} {
      allow create: if signedIn() && (owns(userId) || admin());
      allow read: if owns(userId) || admin();
      allow update: if admin() || owns(userId);
      allow delete: if admin();
    }

    // Public job categories & sectors. Managed by administrators.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Public job listings. Managed by administrators.
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Signed-in candidates submit and view their applications; admins manage all.
    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid;

      allow read: if admin()
        || (signedIn() && resource.data.applicantId == request.auth.uid);

      allow update, delete: if admin();
    }

    // Public contact form submission & 60-second employer requests; admins view/manage.
    match /contact_inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasAll([
        'fullName',
        'email',
        'details'
      ]);
      allow read, update, delete: if admin();
    }

    // Public content & posts, managed by administrators.
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // Customer service requests.
    match /service_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow read: if admin()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow update, delete: if admin();
    }

    // Public company profiles & employer partners. Managed by admins and signed-in employers.
    match /companies/{companyId} {
      allow read: if true;
      allow create, update, delete: if signedIn() || admin();
    }

    // Public candidate professional profiles.
    match /professionals/{profileId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if admin();
    }

    // Verification requests.
    match /verification_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if admin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if admin();
    }

    // User notifications.
    match /notifications/{notificationId} {
      allow create: if admin();
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if admin();
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
